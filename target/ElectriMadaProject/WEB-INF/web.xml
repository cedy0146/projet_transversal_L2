<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0"
         metadata-complete="false">

<display-name>ElectriMadaProject</display-name>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- CORS Filter pour le frontend React -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.electrimada.controleur.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FoyerServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.FoyerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FoyerServlet</servlet-name>
        <url-pattern>/api/foyers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DemandeServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.DemandeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DemandeServlet</servlet-name>
        <url-pattern>/api/demandes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AllocationServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.AllocationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllocationServlet</servlet-name>
        <url-pattern>/api/allocations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BatterieServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.BatterieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BatterieServlet</servlet-name>
        <url-pattern>/api/batterie</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RapportServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.RapportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RapportServlet</servlet-name>
        <url-pattern>/api/rapports</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SyncServlet</servlet-name>
        <servlet-class>com.electrimada.controleur.SyncServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SyncServlet</servlet-name>
        <url-pattern>/api/sync</url-pattern>
    </servlet-mapping>

</web-app>
